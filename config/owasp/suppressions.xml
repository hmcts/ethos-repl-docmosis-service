        <packageUrl regex="true">^pkg:maven/org\.springframework\.security/spring\-security\-crypto@6\.5\.11$</packageUrl>
        <cve>CVE-2026-59270</cve>
    </suppress>
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.data/spring\-data\-jpa@3\.5\.13$</packageUrl>
        <cve>CVE-2026-47834</cve>
    </suppress>
