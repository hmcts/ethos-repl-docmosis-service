<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- Suppressed as the library is no longer getting updates -->
    <suppress>
        <cve>CVE-2021-42306</cve>
    </suppress>
    <!-- False positive: CVE affects nu.validator:validator, not Hibernate Validator. -->
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.hibernate\.validator/hibernate\-validator@.*$</packageUrl>
        <cve>CVE-2025-15104</cve>
    </suppress>
    <!-- False positive: CVE affects Angus SMTP, not the unrelated activation artifact. -->
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus\-activation@2\.0\.3$</packageUrl>
        <cve>CVE-2025-7962</cve>
    </suppress>
    <!-- CVE affects unsafe deserialization in the Kotlin build cache metadata (compiler / build
         tooling), not the kotlin-stdlib runtime artifact pulled transitively into this service. -->
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin\-stdlib.*@.*$</packageUrl>
        <cve>CVE-2026-53914</cve>
    </suppress>
    <!-- False positive: CVE-2026-54399 / CVE-2026-54428 affect HttpComponents Core 5.x
         (org.apache.httpcomponents.core5:httpcore5), which is upgraded to 5.4.3. dependency-check
         mis-matches them onto the unrelated legacy 4.x httpcore via the shared CPE. Scoped to the
         4.x artifact only so the real 5.x issue is still reported if it ever regresses. -->
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents/httpcore@.*$</packageUrl>
        <cve>CVE-2026-54399</cve>
        <cve>CVE-2026-54428</cve>
    </suppress>
    <!-- False positive: DPoP handling is in spring-security-oauth2-jose, which is not present. -->
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.security/spring\-security\-crypto@6\.5\.11$</packageUrl>
        <cve>CVE-2026-41707</cve>
    </suppress>
    <!-- Dependency-Check maps these CPEs to every Spring Framework 6.2.19 artifact.
